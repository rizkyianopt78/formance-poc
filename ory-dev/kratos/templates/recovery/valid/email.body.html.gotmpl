<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background-color: #f0f2f5;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        color: #333;
      }
      .wrapper {
        max-width: 560px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      }
      /* Header */
      .header {
        background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
        padding: 32px 40px;
        text-align: center;
      }
      .header .logo-text {
        font-size: 22px;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.5px;
      }
      .header .logo-dot {
        color: #93c5fd;
      }
      /* Body */
      .body {
        padding: 40px;
      }
      .body h1 {
        font-size: 22px;
        font-weight: 600;
        color: #111;
        margin-bottom: 12px;
      }
      .body p {
        color: #555;
        margin-bottom: 12px;
      }
      /* Button */
      .btn-wrap {
        text-align: center;
        margin: 32px 0;
      }
      .btn {
        display: inline-block;
        background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
        color: #ffffff !important;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 36px;
        border-radius: 8px;
        letter-spacing: 0.2px;
      }
      /* URL fallback */
      .fallback {
        background: #f8f9fa;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 12px 16px;
        margin-top: 8px;
        word-break: break-all;
        font-size: 13px;
        color: #64748b;
      }
      /* Warning */
      .notice {
        background: #fffbeb;
        border-left: 3px solid #f59e0b;
        border-radius: 0 6px 6px 0;
        padding: 12px 16px;
        margin-top: 24px;
        font-size: 13px;
        color: #78350f;
      }
      /* Footer */
      .footer {
        padding: 24px 40px;
        border-top: 1px solid #f1f5f9;
        text-align: center;
        font-size: 12px;
        color: #94a3b8;
      }
      .footer a { color: #94a3b8; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">

        <!-- Header -->
        <div class="header">
          <div class="logo-text">Net<span class="logo-dot">Wallet</span></div>
        </div>

        <!-- Body -->
        <div class="body">
          <h1>Reset Your Password</h1>
          <p>Hi <strong>{{ .Identity.traits.email }}</strong>,</p>
          <p>
            We received a request to reset the password for your account.
            Click the button below to choose a new password.
          </p>

          <div class="btn-wrap">
            <a href="{{ .RecoveryURL }}" class="btn">Reset Password</a>
          </div>

          <p style="font-size:13px; color:#777;">
            If the button above doesn't work, copy and paste this link into your browser:
          </p>
          <div class="fallback">{{ .RecoveryURL }}</div>

          <div class="notice">
            ⚠️ This link will expire in <strong>24 hours</strong>.
            If you did not request a password reset, you can safely ignore this email.
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>© 2026 NetWallet. All rights reserved.</p>
          <p style="margin-top:4px;">
            This is an automated message, please do not reply directly to this email.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
